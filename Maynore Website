<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MAYNORE | Wear Your Legacy</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
:root {
    --black: #0b0b0b;
    --deep-black: #050505;
    --cream: #f8f6f0;
    --cream-dark: #eee7d9;
    --gold: #d4af37;
    --gold-light: #e3c568;
    --white: #ffffff;
    --text: #222;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Montserrat", sans-serif;
    background: var(--cream);
    color: var(--text);
}

h1, h2, h3 {
    font-family: "Cinzel", serif;
    font-weight: 500;
}

/* ================= NAVBAR ================= */

.navbar {
    position: absolute;
    width: 100%;
    top: 0;
    left: 0;
    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 22px 6%;
}

.logo {
    color: var(--gold);
    font-family: "Cinzel", serif;
    font-size: 25px;
    letter-spacing: 7px;
    text-decoration: none;
}

.logo small {
    display: block;
    font-family: "Montserrat", sans-serif;
    font-size: 8px;
    letter-spacing: 4px;
    text-align: center;
    margin-top: 4px;
}

.nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 1px;
    transition: .3s;
}

.nav-links a:hover {
    color: var(--gold);
}

.shop-btn {
    border: 1px solid var(--gold);
    padding: 12px 22px;
    color: var(--gold);
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 1px;
}

/* ================= COMMON ================= */

.section {
    padding: 90px 6%;
}

.section-title {
    text-align: center;
    font-size: 34px;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.section-subtitle {
    text-align: center;
    font-size: 13px;
    opacity: .7;
    margin-bottom: 50px;
}

.gold-line {
    width: 70px;
    height: 1px;
    background: var(--gold);
    margin: 18px auto 25px;
}

/* ================= HERO - DARK ================= */

.hero {
    min-height: 720px;
    background:
        linear-gradient(90deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.65) 45%, rgba(0,0,0,.25)),
        url("images/hero-watch.jpg") center/cover no-repeat;

    color: white;

    display: flex;
    align-items: center;
    padding: 130px 8% 70px;
}

.hero-content {
    max-width: 520px;
}

.hero-logo {
    color: var(--gold);
    font-family: "Cinzel", serif;
    font-size: 65px;
    letter-spacing: 12px;
}

.tagline {
    color: var(--gold);
    letter-spacing: 7px;
    font-size: 15px;
    margin-top: 10px;
}

.hero p {
    margin: 28px 0;
    line-height: 1.9;
    color: #ddd;
    font-size: 14px;
    max-width: 450px;
}

.buttons {
    display: flex;
    gap: 15px;
}

.btn {
    display: inline-block;
    padding: 14px 26px;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 1px;
    transition: .3s;
}

.btn-gold {
    background: var(--gold);
    color: #111;
}

.btn-outline {
    border: 1px solid var(--gold);
    color: var(--gold);
}

.btn:hover {
    transform: translateY(-3px);
}

/* ================= COLLECTION - LIGHT ================= */

.collection {
    background: var(--cream);
    color: var(--text);
}

.products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.product-card {
    background: white;
    border: 1px solid #ddd2bd;
    transition: .4s;
}

.product-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0,0,0,.12);
}

.product-image {
    height: 330px;
    background-size: cover;
    background-position: center;
}

.product-info {
    text-align: center;
    padding: 25px;
}

.product-info h3 {
    font-size: 19px;
    margin-bottom: 10px;
}

.product-info p {
    font-size: 12px;
    opacity: .65;
    margin-bottom: 15px;
}

.explore {
    color: #a27b1c;
    text-decoration: none;
    font-size: 11px;
    letter-spacing: 1px;
}

/* ================= FEATURES - DARK ================= */

.features {
    background:
        linear-gradient(rgba(5,5,5,.94), rgba(5,5,5,.94)),
        url("images/marble.jpg") center/cover;

    color: white;
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: center;
}

.feature {
    padding: 20px;
    border-right: 1px solid rgba(212,175,55,.35);
}

.feature:last-child {
    border-right: none;
}

.icon {
    font-size: 38px;
    color: var(--gold);
    margin-bottom: 18px;
}

.feature h3 {
    font-size: 17px;
    color: var(--gold);
    margin-bottom: 12px;
}

.feature p {
    color: #ccc;
    font-size: 12px;
    line-height: 1.7;
}

/* ================= ABOUT - LIGHT ================= */

.about {
    background: var(--cream);
}

.about-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
}

.about-text h2 {
    font-size: 35px;
    margin-bottom: 20px;
}

.about-text p {
    font-size: 14px;
    line-height: 2;
    color: #555;
    margin-bottom: 25px;
}

.about-image {
    min-height: 400px;
    background: url("images/watchmaker.jpg") center/cover;
}

/* ================= LEGACY - DARK ================= */

.legacy {
    min-height: 390px;

    background:
        linear-gradient(90deg, rgba(0,0,0,.9), rgba(0,0,0,.55)),
        url("images/legacy-watch.jpg") center/cover;

    color: white;

    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.legacy h2 {
    color: var(--gold);
    font-size: 38px;
    margin-bottom: 15px;
}

.legacy p {
    color: #ddd;
    margin-bottom: 25px;
}

/* ================= FOOTER - LIGHT ================= */

footer {
    background: var(--cream);
    color: #222;
    padding: 70px 6% 25px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 45px;
}

.footer-logo {
    font-family: "Cinzel", serif;
    color: #222;
    font-size: 28px;
    letter-spacing: 7px;
}

.footer-tagline {
    color: #a27b1c;
    font-size: 10px;
    letter-spacing: 3px;
    margin-top: 10px;
}

footer h3 {
    font-size: 15px;
    margin-bottom: 20px;
}

footer ul {
    list-style: none;
}

footer li {
    margin-bottom: 10px;
    font-size: 12px;
}

footer a {
    color: #555;
    text-decoration: none;
}

footer a:hover {
    color: var(--gold);
}

.newsletter input {
    width: 100%;
    padding: 13px;
    border: 1px solid #cdbf9f;
    background: transparent;
    margin-bottom: 10px;
}

.newsletter button {
    width: 100%;
    padding: 13px;
    background: var(--gold);
    border: none;
    cursor: pointer;
}

.copyright {
    text-align: center;
    border-top: 1px solid #d8cdb8;
    margin-top: 50px;
    padding-top: 20px;
    font-size: 11px;
    color: #777;
}

/* ================= RESPONSIVE ================= */

@media(max-width: 900px) {

    .nav-links {
        display: none;
    }

    .hero {
        min-height: 650px;
        padding: 130px 7% 70px;
    }

    .hero-logo {
        font-size: 45px;
    }

    .products {
        grid-template-columns: 1fr;
    }

    .feature-grid {
        grid-template-columns: 1fr 1fr;
    }

    .feature {
        border-right: none;
        border-bottom: 1px solid rgba(212,175,55,.25);
    }

    .about-container {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media(max-width: 550px) {

    .section {
        padding: 65px 5%;
    }

    .hero {
        min-height: 700px;
    }

    .hero-logo {
        font-size: 35px;
        letter-spacing: 7px;
    }

    .tagline {
        font-size: 11px;
        letter-spacing: 4px;
    }

    .buttons {
        flex-direction: column;
        max-width: 220px;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

